        "PeelAction": { "$className": "RemoteEvent" },
        "PeelResult": { "$className": "RemoteEvent" },
        "PeelStroke": { "$className": "RemoteEvent" },
        "RetentionRequest": { "$className": "RemoteFunction" },
        "Reward": { "$className": "RemoteEvent" },
        "ShopRequest": { "$className": "RemoteFunction" },
        "Social": { "$className": "RemoteEvent" },
        "SocialRequest": { "$className": "RemoteFunction" },
        "Store": { "$className": "RemoteFunction" }
